        "id": { "type": "string", "description": "شناسه لاگ" },
        "timestamp": { "type": "string", "description": "زمان وقوع" },
        "userId": { "type": "string", "description": "شناسه کاربر مجری" },
        "userName": { "type": "string", "description": "نام کاربر مجری" },
        "userRole": { "type": "string", "description": "نقش کاربر" },
        "action": { "type": "string", "description": "نوع اقدام" },
        "targetEntity": { "type": "string", "description": "موجودیت هدف" },

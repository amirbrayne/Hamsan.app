rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() { return request.auth != null; }
    function getUserRole() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role; }

    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && getUserRole() == 'ADMIN';
    }
    match /applicants/{applicantId} {
      allow create, read, update: if isAuthenticated() && (getUserRole() in ['ADMIN', 'INTERNAL_MANAGER', 'EMPLOYEE', 'COUNSELOR', 'main_admin', 'internal_manager', 'counselor', 'employee']);
      allow delete: if isAuthenticated() && (getUserRole() == 'ADMIN' || getUserRole() == 'main_admin');
    }
    match /applicant_private/{applicantId} {
      allow read, write: if isAuthenticated() && (getUserRole() in ['ADMIN', 'COUNSELOR', 'main_admin', 'counselor']);
    }
    match /introductions/{introId} {
      allow read, create, update: if isAuthenticated() && (getUserRole() in ['ADMIN', 'INTERNAL_MANAGER', 'COUNSELOR', 'main_admin', 'internal_manager', 'counselor']);
      allow delete: if isAuthenticated() && (getUserRole() == 'ADMIN' || getUserRole() == 'main_admin');
    }
    match /tasks/{taskId} { allow read, write: if isAuthenticated(); }
    match /audit_logs/{logId} {
      allow create: if isAuthenticated();
      allow read: if isAuthenticated() && (getUserRole() in ['ADMIN', 'INTERNAL_MANAGER', 'main_admin', 'internal_manager']);
      allow update, delete: if false;
    }
  }
}

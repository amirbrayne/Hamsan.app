rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for Authentication & RBAC
    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isSignedIn() && (
        request.auth.token.role == role ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         getUserData().role == role)
      );
    }

    function isAdmin() {
      return hasRole('main_admin') || hasRole('ADMIN') || hasRole('admin');
    }

    function isManager() {
      return hasRole('internal_manager') || hasRole('INTERNAL_MANAGER') || isAdmin();
    }

    function isCounselor() {
      return hasRole('counselor') || hasRole('COUNSELOR') || isManager();
    }

    function isEmployee() {
      return hasRole('employee') || hasRole('EMPLOYEE') || isManager();
    }

    function isStaff() {
      return isSignedIn() && (isAdmin() || isManager() || isCounselor() || isEmployee());
    }

    // 1. Users collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && (request.auth.uid == userId || isAdmin() || isManager());
      allow delete: if isAdmin();
    }

    // 2. Applicants & Comprehensive Profiles
    match /applicants/{applicantId} {
      allow read: if isStaff() || (isSignedIn() && request.auth.uid == applicantId);
      allow create: if isStaff();
      allow update: if isStaff() || (isSignedIn() && request.auth.uid == applicantId);
      allow delete: if isAdmin() || isManager();
    }

    // 3. Sub-modules & specialized partitions (if split in future architectures)
    match /private_profiles/{profileId} {
      allow read, write: if isCounselor() || isManager() || isAdmin();
    }

    match /personalities/{personalityId} {
      allow read, write: if isCounselor() || isManager() || isAdmin();
    }

    match /education_jobs/{eduId} {
      allow read, write: if isStaff();
    }

    match /marriage_preferences/{prefId} {
      allow read, write: if isStaff();
    }

    // 4. Introductions & Courtship Cases
    match /introductions/{introId} {
      allow read: if isStaff() || (isSignedIn() && (
        resource.data.maleApplicantId == request.auth.uid ||
        resource.data.femaleApplicantId == request.auth.uid
      ));
      allow create, update: if isStaff();
      allow delete: if isAdmin() || isManager();
    }

    // 5. Matches Collection (for Smart Matching cache & analytics)
    match /matches/{matchId} {
      allow read: if isStaff();
      allow write: if isStaff();
      allow delete: if isAdmin() || isManager();
    }

    // 6. Counseling Sessions & Confidential Clinical Records
    match /counseling_sessions/{sessionId} {
      allow read: if isCounselor() || isManager() || (isSignedIn() && resource.data.applicantId == request.auth.uid);
      allow create, update: if isCounselor() || isManager();
      allow delete: if isAdmin() || isManager();
    }

    // 7. Staff Tasks & Follow-up Items
    match /tasks/{taskId} {
      allow read: if isStaff();
      allow create, update: if isStaff();
      allow delete: if isAdmin() || isManager();
    }

    // 8. Audit Logs (Immutable ledger)
    match /audit_logs/{logId} {
      allow read: if isStaff();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // 9. System Settings & Configuration
    match /system_settings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isManager();
    }
  }
}
